---
const base = import.meta.env.BASE_URL;

const navItems = [
  { label: '買う', href: 'https://www.e-uchina.net/fudosan_kaisha/7123' },
  { label: '売る', href: `${base}sell/` },
  { label: '借りる', href: 'https://www.e-uchina.net/fudosan_kaisha/7123' },
  { label: '貸す', href: `${base}lease/` },
  { label: '会社概要', href: `${base}company/` },
  { label: 'お問い合わせ', href: `${base}contact/` }
];
---

<footer class="footer">
  <div class="footer-inner">

    <div class="footer-info">
      <a href={base} class="footer-logo logo">
        <!-- <img src={`${base}images/logo.png`} alt="GOSAMARU ESTATE" /> -->
      </a>

      <address class="footer-address">
        〒904-0003<br />
        沖縄市住吉1-2-19 101号
      </address>
    </div>

    <div class="footer-right">
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        {navItems.map((item) => {
          const isExternal = item.href.startsWith('http');

          return (
            <a
              href={item.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <p class="copyright">© GOSAMARU ESTATE All Right Reserved.</p>
    </div>

    <a href={base} class="page-top" aria-label="ページトップへ戻る">
      <span></span>
    </a>

  </div>
</footer>