---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageVisual from '../components/PageVisual.astro';
import SectionTitle from '../components/SectionTitle.astro';

const title = '売る｜護佐丸エステート';
const description = '沖縄の不動産売却をサポートする護佐丸エステート。';
---

<BaseLayout title={title} description={description} canonical={`https://www.gosamaru-estate.com/sell/`}>
  <PageVisual src="/images/img/sell-mainvisual.png" alt="沖縄の風景" />

  <section class="page-section">
    <div class="page-section-inner">
      <SectionTitle ja="売る" en="SELL" tag="h1" />
      <p class="section-text">このページのコンテンツは、現在のHTML原稿をもとに順次組み込めます。</p>
    </div>
  </section>
</BaseLayout>
