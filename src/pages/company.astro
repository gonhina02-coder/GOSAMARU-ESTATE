---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="会社概要｜護佐丸エステート"
  description="護佐丸エステートの会社概要をご紹介します。代表あいさつ、企業理念など、私たちの想いをご紹介します。"
>

  <!-- =========================
       Company Heading
  ========================== -->
  <section class="company-heading-area">
    <div class="company-heading-area__inner">

      <h1>
        <span class="company-heading-area__title">会社概要</span>
        <span class="company-heading-area__line"></span>
      </h1>

      <p>
        護佐丸エステートの想いと、<br />
        地域とともに歩む私たちの取り組みをご紹介します。
      </p>

    </div>
  </section>


  <!-- =========================
       Representative
  ========================== -->
  <section class="company-message">
    <div class="company-message__inner">

      <div class="company-message__text">

        <div class="company-heading">
          <h2>代表あいさつ</h2>
        </div>

        <h3>
          人と不動産、地域をつなぎ、<br />
          未来を育むパートナーでありたい。
        </h3>

        <p>
          護佐丸エステートは、沖縄の豊かな自然と文化を大切にしながら、
          「安心・信頼・誠実」を基本に、地域の皆さまに寄り添う不動産
          サービスを提供してまいります。
        </p>

        <p>
          不動産は単なる「モノ」ではなく、暮らしや想いが詰まった
          大切な資産です。
        </p>

        <p>
          お客様一人ひとりの想いを受け止め、最適なご提案とサポートで、
          笑顔あふれる未来づくりに貢献していきます。
        </p>

        <div class="representative-name">
          <span class="representative-name__position">
            代表取締役
          </span>

          <span class="representative-name__ja">
            新垣 渉
          </span>

          <span class="representative-name__en">
            WATARU ARAKAKI
          </span>
        </div>

        <div class="representative-signature">
          Wataru Arakaki
        </div>

      </div>


      <div class="company-message__image">
        <img
          src={`${base}/images/img/representative.png`}
          alt="代表取締役 新垣 渉"
        />
      </div>

    </div>
  </section>


  <!-- =========================
       Philosophy
  ========================== -->
  <section class="philosophy">

    <div class="philosophy__inner">

      <div class="section-heading">
        <h2>企業理念</h2>
      </div>

      <p class="philosophy__lead">
        私たちは、地域と共に成長し、信頼される不動産パートナーを目指します。
      </p>


      <div class="philosophy-list">

        <!-- 信頼 -->
        <article class="philosophy-item">

          <div class="philosophy-item__icon">
            <img
              src={`${base}/images/icon/ico-shine.svg`}
              alt=""
            />
          </div>

          <div class="philosophy-item__content">
            <h3>信頼</h3>

            <p>
              お客様との信頼関係を何より
              大切にし、誠実な対応を
              お約束します。
            </p>
          </div>

        </article>


        <!-- 価値 -->
        <article class="philosophy-item">

          <div class="philosophy-item__icon">
            <img
              src={`${base}/images/icon/ico-home_02.svg`}
              alt=""
            />
          </div>

          <div class="philosophy-item__content">
            <h3>価値</h3>

            <p>
              不動産の価値を最大限に引き出し、
              お客様の資産価値向上に
              貢献します。
            </p>
          </div>

        </article>


        <!-- 地域貢献 -->
        <article class="philosophy-item">

          <div class="philosophy-item__icon">
            <img
              src={`${base}/images/icon/ico-team.svg`}
              alt=""
            />
          </div>

          <div class="philosophy-item__content">
            <h3>地域貢献</h3>

            <p>
              地域の発展と暮らしの向上に
              貢献し、沖縄の未来を共に
              創っていきます。
            </p>
          </div>

        </article>

      </div>

    </div>

  </section>


  <!-- =========================
       Contact CTA
  ========================== -->
  <section class="company-contact">

    <div class="company-contact__inner">

      <div class="company-contact__icon">
        <img src={`${base}/images/icon/ico-mail_02.svg`}>
      </div>

      <p>
        不動産に関するご相談・ご質問など、<br />
        お気軽にお問い合わせください。
      </p>

      <a
        href={`${base}contact/`}
        class="company-contact__button"
      >
        お問い合わせはこちら
      </a>

    </div>

  </section>

</BaseLayout>