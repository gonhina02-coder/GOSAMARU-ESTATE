---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageVisual from '../components/PageVisual.astro';
import SectionTitle from '../components/SectionTitle.astro';

const title = '会社概要｜護佐丸エステート';
const description = '護佐丸エステートの会社概要をご案内します。';
---

<BaseLayout title={title} description={description} canonical={`https://www.gosamaru-estate.com/company/`}>
  <PageVisual src="/images/img/company-mainvisual.png" alt="沖縄の風景" />

  <section class="page-section">
    <div class="page-section-inner">
      <SectionTitle ja="会社概要" en="COMPANY" tag="h1" />
      <p class="section-text">このページのコンテンツは、現在のHTML原稿をもとに順次組み込めます。</p>
    </div>
  </section>
</BaseLayout>
