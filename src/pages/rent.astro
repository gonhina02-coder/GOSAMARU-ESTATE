---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageVisual from '../components/PageVisual.astro';
import SectionTitle from '../components/SectionTitle.astro';

const title = '借りる｜護佐丸エステート';
const description = '沖縄の賃貸物件探しをサポートする護佐丸エステート。';
---

<BaseLayout title={title} description={description} canonical={`https://www.gosamaru-estate.com/rent/`}>
  <PageVisual src="/images/img/rent-mainvisual.png" alt="沖縄の風景" />

  <section class="page-section">
    <div class="page-section-inner">
      <SectionTitle ja="借りる" en="RENT" tag="h1" />
      <p class="section-text">このページのコンテンツは、現在のHTML原稿をもとに順次組み込めます。</p>
    </div>
  </section>
</BaseLayout>
