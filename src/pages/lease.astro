---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageVisual from '../components/PageVisual.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="貸す｜護佐丸エステート"
  description="不動産を貸したい方へ。護佐丸エステートが募集から入居、管理までサポートいたします。"
>

  <!-- ページビジュアル -->
  <PageVisual
    src={`${base}images/img/rent-mainvisual.png`}
    alt="沖縄の住宅と海"
  />

  <!-- 貸し出しまでの流れ -->
  <section class="rent-flow">
    <div class="rent-flow-inner">

      <div class="rent-flow-heading">
        <h1 class="rent-flow-title">貸し出しまでの流れ</h1>
        <p class="rent-flow-lead">
          ご相談から入居開始、その後の管理までトータルサポートします。
        </p>
      </div>

      <div class="rent-flow-list">

        <!-- STEP 01 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">1</span>

          <h2 class="rent-flow-item-title">
            ご相談・査定依頼
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-document-search.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            物件の状況やご希望をお伺いし、賃料の査定を行います。
          </p>
        </article>

        <!-- STEP 02 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">2</span>

          <h2 class="rent-flow-item-title">
            賃貸プランのご提案
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-calculator.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            市場調査をもとに、最適な賃貸プランをご提案します。
          </p>
        </article>

        <!-- STEP 03 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">3</span>

          <h2 class="rent-flow-item-title">
            募集・入居者募集
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-megaphone.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            ポータルサイトや自社ネットワークで入居者を募集します。
          </p>
        </article>

        <!-- STEP 04 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">4</span>

          <h2 class="rent-flow-item-title">
            入居審査・契約
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-signature.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            入居希望者の審査・契約手続きを当社で行います。
          </p>
        </article>

        <!-- STEP 05 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">5</span>

          <h2 class="rent-flow-item-title">
            入居開始
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-key.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            鍵のお引渡し・入居日の立ち会いを行います。
          </p>
        </article>

        <!-- STEP 06 -->
        <article class="rent-flow-item">
          <span class="rent-flow-number">6</span>

          <h2 class="rent-flow-item-title">
            管理・サポート
          </h2>

          <div class="rent-flow-icon">
            <img
              src={`${base}images/icon/ico-support.svg`}
              alt=""
            />
          </div>

          <p class="rent-flow-item-text">
            家賃管理やトラブル対応など、入居中もサポートします。
          </p>
        </article>

      </div>

      <!-- CTA -->
      <div class="rent-flow-cta">

        <div class="rent-flow-cta-text">
          <h2>管理までお任せで手間いらず</h2>

          <p>
            家賃の回収・入金管理・クレーム対応・撤去時の対応まで
            すべて当社にお任せいただけます。
          </p>
        </div>

        <a href="/contact/" class="rent-flow-cta-button">
          <span>相談・査定を依頼する</span>
        </a>

      </div>

    </div>
  </section>

</BaseLayout>